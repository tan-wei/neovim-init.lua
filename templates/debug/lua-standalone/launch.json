{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lua: Current file (Lua 5.3)",
      "type": "lua-local",
      "request": "launch",
      "program": {
        "lua": "lua5.3",
        "file": "${file}"
      },
      "cwd": "${workspaceFolder}",
      "stopOnEntry": true
    }
  ]
}